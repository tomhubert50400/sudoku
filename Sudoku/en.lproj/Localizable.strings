"hint.cleanup.complete_notes" = "No cell is 100% justified in your current view. First complete the notes in the gray cells, then I can suggest an elimination or placement without guessing.";
"Contradiction" = "Contradiction";
"hint.contradiction.explanation" = "%@ has candidates %@. If we try %@, the grid has no valid solution left. So %d is forced.";
"hint.full_house.explanation" = "In %@, only %d is missing. The last free cell is %@.";
"hint.locked_candidates.row" = "In %@, every %d is on row %d. Remove %d from the other cells in that row.";
"hint.locked_candidates.column" = "In %@, every %d is on column %d. Remove %d from the other cells in that column.";
"hint.naked_set.explanation" = "%@ can only be %@. Remove those candidates from the other cells in %@.";
"hint.hidden_set.explanation" = "In %@, digits %@ can only go in %@. Remove the other candidates from those cells.";
"hint.xwing.rows" = "%d forms an X-Wing on rows %d and %d, columns %d and %d. Remove %d from those columns.";
"hint.xwing.columns" = "%d forms an X-Wing on columns %d and %d, rows %d and %d. Remove %d from those rows.";
"hint.skyscraper.rows" = "%d forms a Skyscraper on rows %d and %d. One of the two free ends must contain %d, so remove %d from cells that see both.";
"hint.skyscraper.columns" = "%d forms a Skyscraper on columns %d and %d. One of the two free ends must contain %d, so remove %d from cells that see both.";
"hint.two_string_kite.explanation" = "%d forms a 2-String Kite: a strong row link and a strong column link cross through the same box. Remove %d from %@.";
"hint.xy_wing.explanation" = "%@ is the pivot. Whatever it chooses, one of the two wings forces %d. Remove %d from cells that see both wings.";
"hint.xyz_wing.explanation" = "%@ is the XYZ pivot. The two wings cover the other choices, so any cell that sees the pivot and both wings cannot keep %d. Remove %d.";
"hint.w_wing.explanation" = "%@ and %@ form a W-Wing. The strong link on %d forces one of the two wings to take that digit, so candidate %d can be removed from cells that see both wings.";
"hint.simple_colors.wrap" = "Coloring on %d: two candidates with the same color see each other, so that color is impossible. Remove %d from those cells.";
"hint.simple_colors.trap" = "Coloring on %d: %@ sees both colors. One color must be true, so %@ cannot keep %d.";
"hint.xy_chain.explanation" = "XY-Chain %@. The two ends cannot both exclude %d, so remove %d from cells that see both ends.";
"hint.fish.explanation" = "%d forms a %@ with %@, aligned on %@. Remove %d from the other cells in those zones.";
"hint.finned_fish.explanation" = "%d forms a %@ on %@, aligned on %@, with fin(s) at %@. Any marked cell that sees the fins cannot keep %d.";
"hint.unique_rectangle_type_1.explanation" = "The %@ rectangle would create two solutions if %@ kept only those two digits. Remove the rectangle pair from that cell.";
"hint.bug_plus_one.explanation" = "Every unsolved cell is bi-value except %@. To avoid a BUG pattern, %@ must take %d.";
"hint.x_chain.explanation" = "X-Chain on %d: %@. One end of the chain must be true, so remove %d from cells that see both ends.";
"hint.aic.explanation" = "AIC %@. One end of the alternating chain must be true, so remove %d from cells that see both ends.";
